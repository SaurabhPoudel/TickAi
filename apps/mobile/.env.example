# Your API. On a physical phone use your computer's LAN IP, e.g. http://192.168.1.20:8787
EXPO_PUBLIC_API_URL=http://localhost:8787

# Supabase project (Settings > API). Leave empty to use dev auth against a local API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# true = run the app on built-in sample data, no API needed (used for the web demo)
EXPO_PUBLIC_DEMO=false
