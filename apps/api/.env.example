PORT=8787
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hushtick

# Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Fast model for turning speech into tasks, smarter model for the bedtime conversation
CAPTURE_MODEL=claude-haiku-4-5-20251001
CHECKIN_MODEL=claude-sonnet-5-5
# low | medium | high. Low keeps the bedtime conversation snappy.
CHECKIN_EFFORT=low

# Supabase auth (the app signs users in anonymously first, account later)
SUPABASE_URL=
# Local development only: lets you send `x-dev-user: <any id>` instead of a token
ALLOW_DEV_AUTH=true

# Google Calendar (Google Cloud console > OAuth client, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/google/callback
# Where to send the user after Google connects (the app's deep link)
APP_REDIRECT_URI=hushtick://settings
# Web app origins allowed as a return address after Google sign-in
WEB_APP_ORIGINS=http://localhost:8081
