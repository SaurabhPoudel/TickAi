{
  "name": "@tuck/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "tsx --test src/**/*.test.ts",
    "seed": "tsx --env-file=.env src/scripts/seed.ts",
    "try-ai": "tsx --env-file-if-exists=.env src/scripts/try-ai.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@fastify/cors": "^11.3.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "googleapis": "^182.0.0",
    "jose": "^6.2.12",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
